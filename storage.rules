rules_version = '2';

// Product photos only. Any member of staff may read and write, because adding
// stock is a cashier-facing screen in this app, not an admin-only one.
service firebase.storage {
  match /b/{bucket}/o {
    // Staff only, as in firestore.rules: a Firebase Auth account alone is
    // not enough. (Cross-service rules — the first deploy asks to let
    // Storage read Firestore; say yes.)
    function isStaff() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', true) != false;
    }

    match /products/{productId}/{fileName} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }

    // Nothing else is writable from a browser.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
