# SMTP for the new-device approval emails (functions/.env is gitignored).
# Copy to functions/.env and fill in — `firebase deploy --only functions`
# uploads .env as the deployed functions' environment.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@5xcodes.com
SMTP_PASS=
SMTP_FROM="VSP Farm" <noreply@5xcodes.com>

# SMSlenz (smslenz.lk) — bill and promotion SMS. The sender ID must be one
# registered to this shop on your SMSlenz account.
SMSLENZ_USER_ID=
# SMSLENZ_API_KEY is a Secret Manager secret: firebase functions:secrets:set SMSLENZ_API_KEY
SMSLENZ_SENDER_ID=

# Where the app is hosted — used for the order track link in SMS and the
# /orders link in the 4pm alert. Defaults to https://vsp-farm-web.web.app.
APP_BASE_URL=
